# SparkCode Production & Development Environment Variables

# NextAuth / Auth.js Secret (generate using `openssl rand -base64 32`)
AUTH_SECRET="your-32-character-random-secret-key"

# Database Connection (SQLite local or PostgreSQL/Supabase/Render Postgres in production)
DATABASE_URL="file:./dev.db"

# Optional: NextAuth URL (usually auto-detected on Render/Vercel)
# NEXTAUTH_URL="https://your-app-name.onrender.com"

# Optional: Google OAuth Credentials (leave blank if only using password/guest login)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
